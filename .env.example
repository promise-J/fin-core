# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=fincore-api

# DATABASE_URL=postgresql://fincore:fincore@localhost:5432/fincore
# REDIS_URL=redis://localhost:6379
# RABBITMQ_URL=amqp://fincore:fincore@localhost:5672

# --- Core ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=fincore-api

# --- Database (already there) ---
DATABASE_URL="postgresql://fincore:fincore@localhost:5432/fincore_dev?schema=public"

# --- Auth (used starting 2.4, but validate now so nothing surprises us later) ---
JWT_ACCESS_SECRET=change-me-to-a-32-byte-random-string-in-production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Redis (used starting 2.6) ---
REDIS_URL=redis://localhost:6379

# --- HTTP ---
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT_BYTES=1048576